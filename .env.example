# Kopieer naar .env voor lokale ontwikkeling. Commit nooit een .env met echte geheimen.

APP_ENV=development
DATABASE_URL=sqlite:///./ledenadmin.db
TIMEZONE=Europe/Amsterdam

# dev = geen echte aanmelding (alleen lokaal); easyauth = Azure Container Apps-authenticatie
AUTH_MODE=dev
DEV_USER_NAME=ontwikkelaar
DEV_USER_ROLES=beheerder,penningmeester,bestuurder
ROLE_CLAIM_TYPE=roles
# Platformbeheerders (issuer|subject), komma-gescheiden
SUPERADMIN_SUBJECTS=
# Inlogpagina van Easy Auth (zie 4-EntraExternalID.md)
EASYAUTH_LOGIN_URL=/.auth/login/aad
# Melding bij elke nieuwe organisatie (optioneel)
SUPERADMIN_EMAIL=
# Basis-URL voor links in e-mails
PUBLIC_BASE_URL=http://localhost:8000
# Optioneel: controle van KVK-nummers in het Handelsregister
KVK_API_KEY=
MAX_ORGANIZATIONS_PER_USER=3
# Optioneel: e-mail via Brevo; zonder sleutel delen beheerders de uitnodigingslink zelf
BREVO_API_KEY=
MAIL_SENDER_EMAIL=noreply@example.nl
MAIL_SENDER_NAME=Ashab al-Jannah
MAIL_DAILY_LIMIT=300

ALLOW_DONATIONS_FOR_INACTIVE_MEMBERS=false
SEED_DEFAULT_CATEGORIES=true

# AI: local (standaard, geen externe dienst), openai of anthropic
AI_PROVIDER=local
# AI_MODEL=
# AI_TIMEOUT_SECONDS=20
# OPENAI_API_KEY=
# OPENAI_BASE_URL=   # bijv. https://<resource>.openai.azure.com/openai/v1/ voor Azure OpenAI
# ANTHROPIC_API_KEY=

# Azure SQL met managed identity (vereist ODBC Driver 18 en pyodbc):
# DATABASE_URL=mssql+pyodbc:///?odbc_connect=Driver%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BServer%3Dtcp%3A<server>.database.windows.net%2C1433%3BDatabase%3D<database>%3BEncrypt%3Dyes%3BAuthentication%3DActiveDirectoryMsi%3BConnection+Timeout%3D60

# Online doneren (Mollie). Versleutelt de API-sleutels van stichtingen in de database.
# Genereer: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leeg = online doneren uit. Bewaar deze sleutel goed: kwijt = alle stichtingen opnieuw koppelen.
SECRET_ENCRYPTION_KEY=
# MOLLIE_API_URL=https://api.mollie.com/v2

# KVK_API_URL=https://api.kvk.nl/api/v2/zoeken
# Alleen bij APP_ENV=production met SQLite (afgeraden):
# ALLOW_SQLITE_IN_PRODUCTION=false
